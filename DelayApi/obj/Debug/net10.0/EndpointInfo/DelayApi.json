{
  "openapi": "3.1.1",
  "info": {
    "title": "DelayApi | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7277"
    },
    {
      "url": "http://localhost:5253"
    }
  ],
  "paths": {
    "/api/journey": {
      "get": {
        "tags": [
          "Journey"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Journey"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JourneySearch"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/JourneySearch"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/JourneySearch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "JourneySearch": {
        "required": [
          "taskKey",
          "departureStation",
          "arrivalStation"
        ],
        "type": "object",
        "properties": {
          "taskKey": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "departureStation": {
            "type": [
              "null",
              "string"
            ]
          },
          "arrivalStation": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Journey"
    }
  ]
}